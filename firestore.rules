rules_version = '2';

// Règles EcoFlow – Epics 1 (profils), 2 (vision IA), 3 (estimation & pesée), 4 (collectes), 5 (missions).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Transition de statut autorisée à l'utilisateur : (re)soumettre son dossier.
    function submitsForReview() {
      return request.resource.data.verificationStatus == 'pending'
        && resource.data.verificationStatus in ['notSubmitted', 'rejected'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Un administrateur ne peut jamais être auto-attribué (US-003) et le
      // consentement est obligatoire.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['citizen', 'collector', 'recycler']
        && request.resource.data.verificationStatus
             == (request.resource.data.role == 'citizen' ? 'notRequired' : 'notSubmitted')
        && request.resource.data.consent.version is string
        && request.resource.data.status == 'active';

      allow update: if isAdmin()
        || (isSelf(uid)
            && !changed().hasAny(['role', 'createdAt', 'consent', 'rejectionReason', 'reviewedBy', 'reviewedAt'])
            && (!changed().hasAny(['verificationStatus']) || submitsForReview())
            && (!changed().hasAny(['status']) || request.resource.data.status == 'deleted'));

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 120
          && request.resource.data.street is string
          && request.resource.data.city is string
          && request.resource.data.isDefault is bool;
        allow delete: if isSelf(uid);
      }

      match /documents/{type} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isAdmin()
          || (isSelf(uid)
              && type in ['nationalId', 'drivingLicense', 'vehicleRegistration', 'vehiclePhoto']
              && request.resource.data.status in ['notSubmitted', 'pending']
              && !request.resource.data.keys().hasAny(['rejectionReason']));
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /documentFiles/{type} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && type in ['nationalId', 'drivingLicense', 'vehicleRegistration', 'vehiclePhoto']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    match /companies/{uid} {
      // Les recycleurs validés sont visibles des utilisateurs connectés.
      allow read: if isSelf(uid) || isAdmin()
        || (signedIn() && resource.data.status == 'approved');
      allow create, update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.status == 'pending'
            && request.resource.data.ownerUid == uid
            && request.resource.data.rejectionReason == null
            && (resource == null || resource.data.status in ['notSubmitted', 'rejected']
                || changed().hasOnly(['contactPhone'])));
      allow delete: if isAdmin();
    }

    match /deletionRequests/{uid} {
      allow create: if isSelf(uid);
      allow read, update, delete: if isAdmin();
    }

    // --- Epic 2 : scans (privés) ---------------------------------------
    function ownsScan() { return signedIn() && resource.data.uid == request.auth.uid; }

    match /scans/{scanId} {
      allow read: if ownsScan() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.photoCount is int
        && request.resource.data.photoCount <= 5;
      // L'utilisateur corrige son résultat, sans toucher à la proposition de l'IA.
      allow update: if ownsScan()
        && !changed().hasAny(['uid', 'createdAt', 'expiresAt', 'originalDetections', 'modelVersionId']);
      allow delete: if ownsScan() || isAdmin();

      match /photos/{index} {
        // Collecteurs vérifiés : photos du scan visibles dans la mission (US-045).
        allow read: if ownsScan() || isAdmin() || isApprovedCollector();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && index in ['0', '1', '2', '3', '4']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000;
        allow delete: if ownsScan() || isAdmin();
      }
    }

    // Catalogue, versions du modèle et configuration : lecture pour tous
    // les utilisateurs connectés, écriture réservée aux administrateurs.
    match /wasteCategories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /modelVersions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Epic 3 : barèmes, estimations et pesées --------------------------
    function isApprovedCollector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'collector'
        && userDoc().verificationStatus == 'approved';
    }

    // Historique immuable : on publie un nouveau barème, on n'en modifie aucun.
    match /priceScales/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.prices is map;
      allow update, delete: if false;
    }

    match /estimates/{code} {
      // Lecture unitaire par code : propriétaire, collecteur vérifié, admin.
      // `resource == null` : vérification d'unicité du code à la création.
      allow get: if signedIn() && (resource == null
        || resource.data.citizenUid == request.auth.uid
        || isApprovedCollector()
        || isAdmin());
      // Pas de liste pour les collecteurs : uniquement ses propres estimations.
      allow list: if signedIn() && (resource.data.citizenUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.status == 'estimated'
        && request.resource.data.lines is list;
      // Pesée : une seule fois, par un collecteur vérifié, sans toucher à l'estimation.
      // Le citoyen relie son estimation à sa demande de collecte (epic 4).
      allow update: if (signedIn() && resource.data.citizenUid == request.auth.uid
          && resource.data.status == 'estimated'
          && changed().hasOnly(['requestId'])) || isAdmin() || (isApprovedCollector()
        && resource.data.status == 'estimated'
        && request.resource.data.status == 'weighed'
        && request.resource.data.collectorUid == request.auth.uid
        && changed().hasOnly(['status', 'actualKg', 'actualTotalKg', 'finalDt', 'collectorUid', 'weighedAt']));
      allow delete: if isAdmin();
    }

    // --- Epic 4 : demandes de collecte -------------------------------------
    function ownsCollection() { return signedIn() && resource.data.citizenUid == request.auth.uid; }

    match /collections/{id} {
      allow get: if ownsCollection() || isApprovedCollector() || isAdmin();
      // Collecteurs vérifiés : demandes ouvertes, proposées à eux, ou les leurs.
      allow list: if ownsCollection() || isAdmin() || (isApprovedCollector()
        && (resource.data.status in ['searching', 'noCollector']
            || resource.data.proposedCollectorUid == request.auth.uid
            || resource.data.collectorUid == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.instructions.size() <= 300
        && get(/databases/$(database)/documents/estimates/$(request.resource.data.estimateCode)).data.citizenUid == request.auth.uid;
      // Citoyen : lieu, créneau, instructions, recherche, annulation,
      // confirmation de remise (après la pesée), note.
      allow update: if isAdmin()
        || (ownsCollection()
            && !changed().hasAny(['citizenUid', 'estimateCode', 'collectorUid', 'createdAt'])
            && request.resource.data.instructions.size() <= 300
            && request.resource.data.status in ['searching', 'noCollector', 'proposed', 'cancelled', 'completed', resource.data.status]
            && (request.resource.data.status != 'completed' || resource.data.status in ['handedOver', 'completed'])
            // Une collecte terminée n'accepte plus que la marque « notée ».
            && (resource.data.status != 'completed' || changed().hasOnly(['rated'])))
        // Collecteur : acceptation verrouillée (première acceptation).
        || (isApprovedCollector()
            && request.resource.data.status == 'accepted'
            && request.resource.data.collectorUid == request.auth.uid
            && resource.data.get('collectorUid', null) == null
            && (resource.data.status in ['searching', 'noCollector']
                || (resource.data.status == 'proposed' && resource.data.proposedCollectorUid == request.auth.uid))
            && changed().hasOnly(['status', 'collectorUid', 'proposedCollectorUid', 'acceptedAt', 'statusHistory', 'updatedAt']))
        // Collecteur : refus d'une proposition (ou délai dépassé).
        || (isApprovedCollector()
            && resource.data.status == 'proposed' && resource.data.proposedCollectorUid == request.auth.uid
            && request.resource.data.status == 'searching'
            && request.resource.data.refusedBy.hasAll(resource.data.refusedBy)
            && request.auth.uid in request.resource.data.refusedBy
            && changed().hasOnly(['status', 'proposedCollectorUid', 'refusedBy', 'statusHistory', 'updatedAt']))
        // Collecteur : déroulé sur place, photo preuve, dépôt, absence du citoyen.
        || (isApprovedCollector() && resource.data.collectorUid == request.auth.uid
            && request.resource.data.collectorUid == request.auth.uid
            && ((resource.data.status == 'accepted' && request.resource.data.status == 'onTheWay')
                || (resource.data.status == 'onTheWay' && request.resource.data.status == 'arrived')
                || (resource.data.status == 'arrived' && request.resource.data.status == 'inProgress')
                || (request.resource.data.status == resource.data.status
                    && changed().hasOnly(['hasProof', 'depositId', 'updatedAt']))
                || (resource.data.status in ['arrived', 'inProgress'] && request.resource.data.status == 'cancelled'
                    && request.resource.data.cancelledBy == 'collector'))
            && !changed().hasAny(['citizenUid', 'estimateCode', 'place', 'slotId', 'estimatedKg', 'estimatedDt']))
        // Collecteur vérifié : remise validée par sa propre pesée (même batch),
        // photo preuve obligatoire (US-048).
        || (isApprovedCollector()
            && request.resource.data.status == 'handedOver'
            && request.resource.data.collectorUid == request.auth.uid
            && resource.data.collectorUid == request.auth.uid
            && resource.data.get('hasProof', false) == true
            && resource.data.status in ['accepted', 'onTheWay', 'arrived', 'inProgress']
            && getAfter(/databases/$(database)/documents/estimates/$(resource.data.estimateCode)).data.status == 'weighed'
            && getAfter(/databases/$(database)/documents/estimates/$(resource.data.estimateCode)).data.collectorUid == request.auth.uid
            && changed().hasOnly(['status', 'collectorUid', 'statusHistory', 'handedOverAt', 'updatedAt']));
      allow delete: if isAdmin();

      match /attachments/{name} {
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || isApprovedCollector() || isAdmin()
          || get(/databases/$(database)/documents/collections/$(id)).data.citizenUid == request.auth.uid);
        // Instructions : le citoyen ; preuve : le collecteur de la mission.
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 1000000
          && ((name == 'instructions'
                && get(/databases/$(database)/documents/collections/$(id)).data.citizenUid == request.auth.uid)
              || (name == 'proof'
                && get(/databases/$(database)/documents/collections/$(id)).data.collectorUid == request.auth.uid));
        allow update: if name == 'proof' && signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Compteurs de créneaux : +/- 1 uniquement.
    match /slotCounters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.count == 1;
      allow update: if signedIn()
        && (request.resource.data.count == resource.data.count + 1
            || request.resource.data.count == resource.data.count - 1
            || (resource.data.count == 0 && request.resource.data.count == 0));
    }

    // Disponibilité : visible seulement quand le collecteur est en ligne.
    match /collectorPresence/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.online == true;
      allow write: if isSelf(uid) && userDoc().role == 'collector';
    }

    // Note moyenne : mise à jour par une nouvelle note uniquement.
    match /collectorStats/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.ratingCount == (resource == null ? 0 : resource.data.ratingCount) + 1;
    }

    // Une note par collecte, par le citoyen, une fois la collecte terminée.
    match /ratings/{collectionId} {
      allow read: if signedIn() && (resource == null || resource.data.citizenUid == request.auth.uid
        || resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.comment.size() <= 500
        && get(/databases/$(database)/documents/collections/$(collectionId)).data.citizenUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(collectionId)).data.status == 'completed';
      allow update, delete: if false;
    }

    // Signalements : ticket pour l'administration (traitement : epic 12).
    match /tickets/{id} {
      allow read: if signedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && (get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.citizenUid == request.auth.uid
            || get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.collectorUid == request.auth.uid);
      allow update: if isAdmin();

      match /photos/{i} {
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 1000000;
      }
    }

    // --- Epic 5 : revenus, retraits, dépôts ------------------------------
    // Revenu d'une mission terminée : montant = valeur finale de la pesée.
    match /earnings/{missionId} {
      allow read: if signedIn() && (resource == null || resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(missionId)).data.collectorUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(missionId)).data.status == 'completed'
        && request.resource.data.amountDt == get(/databases/$(database)/documents/estimates/$(get(/databases/$(database)/documents/collections/$(missionId)).data.estimateCode)).data.finalDt;
      allow update, delete: if isAdmin();
    }

    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.amountDt >= 20;
      allow update: if isAdmin();
    }

    match /deposits/{id} {
      allow read: if signedIn() && (resource.data.collectorUid == request.auth.uid
        || resource.data.recyclerUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.missionIds.size() <= 50
        && get(/databases/$(database)/documents/companies/$(request.resource.data.recyclerUid)).data.status == 'approved';
      // Le recycleur destinataire confirme ou refuse la réception.
      allow update: if isAdmin() || (signedIn() && resource.data.recyclerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected']
        && changed().hasOnly(['status', 'note', 'reviewedAt']));
    }
  }
}
