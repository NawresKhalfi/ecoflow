rules_version = '2';

// Règles EcoFlow – Epics 1 (profils), 2 (vision IA), 3 (estimation & pesée), 4 (collectes), 5 (missions), 7 (suivi & notifications).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Transition de statut autorisée à l'utilisateur : (re)soumettre son dossier.
    function submitsForReview() {
      return request.resource.data.verificationStatus == 'pending'
        && resource.data.verificationStatus in ['notSubmitted', 'rejected'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Un administrateur ne peut jamais être auto-attribué (US-003) et le
      // consentement est obligatoire.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['citizen', 'collector', 'recycler']
        && request.resource.data.verificationStatus
             == (request.resource.data.role == 'citizen' ? 'notRequired' : 'notSubmitted')
        && request.resource.data.consent.version is string
        && request.resource.data.status == 'active';

      allow update: if isAdmin()
        || (isSelf(uid)
            && !changed().hasAny(['role', 'createdAt', 'consent', 'rejectionReason', 'reviewedBy', 'reviewedAt'])
            && (!changed().hasAny(['verificationStatus']) || submitsForReview())
            && (!changed().hasAny(['status']) || request.resource.data.status == 'deleted'));

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 120
          && request.resource.data.street is string
          && request.resource.data.city is string
          && request.resource.data.isDefault is bool;
        allow delete: if isSelf(uid);
      }

      match /documents/{type} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isAdmin()
          || (isSelf(uid)
              && type in ['nationalId', 'drivingLicense', 'vehicleRegistration', 'vehiclePhoto']
              && request.resource.data.status in ['notSubmitted', 'pending']
              && !request.resource.data.keys().hasAny(['rejectionReason']));
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /documentFiles/{type} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid)
          && type in ['nationalId', 'drivingLicense', 'vehicleRegistration', 'vehiclePhoto']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    match /companies/{uid} {
      // Les recycleurs validés sont visibles des utilisateurs connectés.
      allow read: if isSelf(uid) || isAdmin()
        || (signedIn() && resource.data.status == 'approved');
      allow create, update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.status == 'pending'
            && request.resource.data.ownerUid == uid
            && request.resource.data.rejectionReason == null
            && (resource == null || resource.data.status in ['notSubmitted', 'rejected']
                || changed().hasOnly(['contactPhone'])))
        // Recycleur validé : conditions d'achat par matière (US-085).
        || (isSelf(uid) && resource != null && resource.data.status == 'approved'
            && changed().hasOnly(['purchasing']) && request.resource.data.purchasing is map);
      allow delete: if isAdmin();
    }

    match /deletionRequests/{uid} {
      allow create: if isSelf(uid);
      allow read, update, delete: if isAdmin();
    }

    // --- Epic 2 : scans (privés) ---------------------------------------
    function ownsScan() { return signedIn() && resource.data.uid == request.auth.uid; }

    match /scans/{scanId} {
      allow read: if ownsScan() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.photoCount is int
        && request.resource.data.photoCount <= 5;
      // L'utilisateur corrige son résultat, sans toucher à la proposition de l'IA.
      allow update: if ownsScan()
        && !changed().hasAny(['uid', 'createdAt', 'expiresAt', 'originalDetections', 'modelVersionId']);
      allow delete: if ownsScan() || isAdmin();

      match /photos/{index} {
        // Collecteurs vérifiés : photos du scan visibles dans la mission (US-045).
        allow read: if ownsScan() || isAdmin() || isApprovedCollector();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && index in ['0', '1', '2', '3', '4']
          && request.resource.data.data is string
          && request.resource.data.data.size() < 1000000;
        allow delete: if ownsScan() || isAdmin();
      }
    }

    // Catalogue, versions du modèle et configuration : lecture pour tous
    // les utilisateurs connectés, écriture réservée aux administrateurs.
    match /wasteCategories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /modelVersions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // Historique des paramètres (optimisation, US-062).
      match /history/{h} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // --- Epic 3 : barèmes, estimations et pesées --------------------------
    function isApprovedCollector() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'collector'
        && userDoc().verificationStatus == 'approved';
    }

    // Historique immuable : on publie un nouveau barème, on n'en modifie aucun.
    match /priceScales/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.prices is map;
      allow update, delete: if false;
    }

    match /estimates/{code} {
      // Lecture unitaire par code : propriétaire, collecteur vérifié, admin.
      // `resource == null` : vérification d'unicité du code à la création.
      allow get: if signedIn() && (resource == null
        || resource.data.citizenUid == request.auth.uid
        || isApprovedCollector()
        || isAdmin());
      // Pas de liste pour les collecteurs : uniquement ses propres estimations.
      allow list: if signedIn() && (resource.data.citizenUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.status == 'estimated'
        && request.resource.data.lines is list;
      // Pesée : une seule fois, par un collecteur vérifié, sans toucher à l'estimation.
      // Le citoyen relie son estimation à sa demande de collecte (epic 4).
      allow update: if (signedIn() && resource.data.citizenUid == request.auth.uid
          && resource.data.status == 'estimated'
          && changed().hasOnly(['requestId'])) || isAdmin() || (isApprovedCollector()
        && resource.data.status == 'estimated'
        && request.resource.data.status == 'weighed'
        && request.resource.data.collectorUid == request.auth.uid
        && changed().hasOnly(['status', 'actualKg', 'actualTotalKg', 'finalDt', 'collectorUid', 'weighedAt']));
      allow delete: if isAdmin();
    }

    // --- Epic 4 : demandes de collecte -------------------------------------
    function ownsCollection() { return signedIn() && resource.data.citizenUid == request.auth.uid; }

    match /collections/{id} {
      allow get: if ownsCollection() || isApprovedCollector() || isAdmin();
      // Collecteurs vérifiés : demandes ouvertes, proposées à eux, ou les leurs.
      allow list: if ownsCollection() || isAdmin() || (isApprovedCollector()
        && (resource.data.status in ['searching', 'noCollector']
            || resource.data.proposedCollectorUid == request.auth.uid
            || resource.data.collectorUid == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.status == 'searching'
        && request.resource.data.instructions.size() <= 300
        && get(/databases/$(database)/documents/estimates/$(request.resource.data.estimateCode)).data.citizenUid == request.auth.uid;
      // Citoyen : lieu, créneau, instructions, recherche, annulation,
      // confirmation de remise (après la pesée), note.
      allow update: if isAdmin()
        || (ownsCollection()
            && !changed().hasAny(['citizenUid', 'estimateCode', 'collectorUid', 'createdAt'])
            && request.resource.data.instructions.size() <= 300
            && request.resource.data.status in ['searching', 'noCollector', 'proposed', 'cancelled', 'completed', resource.data.status]
            && (request.resource.data.status != 'completed' || resource.data.status in ['handedOver', 'completed'])
            // Une collecte terminée n'accepte plus que la marque « notée ».
            && (resource.data.status != 'completed' || changed().hasOnly(['rated'])))
        // Collecteur : acceptation verrouillée (première acceptation).
        || (isApprovedCollector()
            && request.resource.data.status == 'accepted'
            && request.resource.data.collectorUid == request.auth.uid
            && resource.data.get('collectorUid', null) == null
            && (resource.data.status in ['searching', 'noCollector']
                || (resource.data.status == 'proposed' && resource.data.proposedCollectorUid == request.auth.uid))
            && changed().hasOnly(['status', 'collectorUid', 'proposedCollectorUid', 'acceptedAt', 'statusHistory', 'updatedAt']))
        // Collecteur : refus d'une proposition (ou délai dépassé).
        || (isApprovedCollector()
            && resource.data.status == 'proposed' && resource.data.proposedCollectorUid == request.auth.uid
            && request.resource.data.status == 'searching'
            && request.resource.data.refusedBy.hasAll(resource.data.refusedBy)
            && request.auth.uid in request.resource.data.refusedBy
            && changed().hasOnly(['status', 'proposedCollectorUid', 'refusedBy', 'statusHistory', 'updatedAt']))
        // Collecteur : déroulé sur place, photo preuve, dépôt, absence du citoyen.
        || (isApprovedCollector() && resource.data.collectorUid == request.auth.uid
            && request.resource.data.collectorUid == request.auth.uid
            && ((resource.data.status == 'accepted' && request.resource.data.status == 'onTheWay')
                || (resource.data.status == 'onTheWay' && request.resource.data.status == 'arrived')
                || (resource.data.status == 'arrived' && request.resource.data.status == 'inProgress')
                || (request.resource.data.status == resource.data.status
                    && changed().hasOnly(['hasProof', 'depositId', 'updatedAt']))
                || (resource.data.status in ['arrived', 'inProgress'] && request.resource.data.status == 'cancelled'
                    && request.resource.data.cancelledBy == 'collector'))
            && !changed().hasAny(['citizenUid', 'estimateCode', 'place', 'slotId', 'estimatedKg', 'estimatedDt']))
        // Collecteur vérifié : remise validée par sa propre pesée (même batch),
        // photo preuve obligatoire (US-048).
        || (isApprovedCollector()
            && request.resource.data.status == 'handedOver'
            && request.resource.data.collectorUid == request.auth.uid
            && resource.data.collectorUid == request.auth.uid
            && resource.data.get('hasProof', false) == true
            && resource.data.status in ['accepted', 'onTheWay', 'arrived', 'inProgress']
            && getAfter(/databases/$(database)/documents/estimates/$(resource.data.estimateCode)).data.status == 'weighed'
            && getAfter(/databases/$(database)/documents/estimates/$(resource.data.estimateCode)).data.collectorUid == request.auth.uid
            && changed().hasOnly(['status', 'collectorUid', 'statusHistory', 'handedOverAt', 'updatedAt']));
      allow delete: if isAdmin();

      // Messagerie entre le citoyen et le collecteur assigné (US-067).
      match /messages/{m} {
        function party() {
          let c = get(/databases/$(database)/documents/collections/$(id)).data;
          return signedIn() && (c.citizenUid == request.auth.uid || c.get('collectorUid', '') == request.auth.uid);
        }
        allow read: if party() || isAdmin();
        allow create: if party()
          && get(/databases/$(database)/documents/collections/$(id)).data.get('collectorUid', null) != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /attachments/{name} {
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || isApprovedCollector() || isAdmin()
          || get(/databases/$(database)/documents/collections/$(id)).data.citizenUid == request.auth.uid);
        // Instructions : le citoyen ; preuve : le collecteur de la mission.
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 1000000
          && ((name == 'instructions'
                && get(/databases/$(database)/documents/collections/$(id)).data.citizenUid == request.auth.uid)
              || (name == 'proof'
                && get(/databases/$(database)/documents/collections/$(id)).data.collectorUid == request.auth.uid));
        allow update: if name == 'proof' && signedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Compteurs de créneaux : +/- 1 uniquement.
    match /slotCounters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.count == 1;
      allow update: if signedIn()
        && (request.resource.data.count == resource.data.count + 1
            || request.resource.data.count == resource.data.count - 1
            || (resource.data.count == 0 && request.resource.data.count == 0));
    }

    // Disponibilité : visible seulement quand le collecteur est en ligne.
    match /collectorPresence/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.online == true;
      allow write: if isSelf(uid) && userDoc().role == 'collector';
    }

    // Note moyenne : mise à jour par une nouvelle note uniquement.
    match /collectorStats/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.ratingCount == (resource == null ? 0 : resource.data.ratingCount) + 1;
    }

    // Une note par collecte, par le citoyen, une fois la collecte terminée.
    match /ratings/{collectionId} {
      allow read: if signedIn() && (resource == null || resource.data.citizenUid == request.auth.uid
        || resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.citizenUid == request.auth.uid
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.comment.size() <= 500
        && get(/databases/$(database)/documents/collections/$(collectionId)).data.citizenUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(collectionId)).data.status == 'completed';
      allow update, delete: if false;
    }

    // Signalements : ticket pour l'administration (traitement : epic 12).
    match /tickets/{id} {
      allow read: if signedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && (get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.citizenUid == request.auth.uid
            || get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data.collectorUid == request.auth.uid);
      allow update: if isAdmin();

      match /photos/{i} {
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.data.size() < 1000000;
      }
    }

    // --- Epic 5 : revenus, retraits, dépôts ------------------------------
    // Revenu d'une mission terminée : montant = valeur finale de la pesée.
    match /earnings/{missionId} {
      allow read: if signedIn() && (resource == null || resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(missionId)).data.collectorUid == request.auth.uid
        && get(/databases/$(database)/documents/collections/$(missionId)).data.status == 'completed'
        && request.resource.data.amountDt == get(/databases/$(database)/documents/estimates/$(get(/databases/$(database)/documents/collections/$(missionId)).data.estimateCode)).data.finalDt
        && getAfter(/databases/$(database)/documents/collectorBalances/$(request.auth.uid)).data.lastEarningId == missionId;
      allow update, delete: if isAdmin();
    }

    // Solde du collecteur, modifié uniquement avec un revenu ou un retrait
    // du même batch : impossible de retirer plus que le total gagné.
    match /collectorBalances/{uid} {
      function before(k) { return resource == null ? 0 : resource.data[k]; }
      function earningAdded() {
        return request.resource.data.withdrawnDt == before('withdrawnDt')
          && !exists(/databases/$(database)/documents/earnings/$(request.resource.data.lastEarningId))
          && existsAfter(/databases/$(database)/documents/earnings/$(request.resource.data.lastEarningId))
          && request.resource.data.earnedDt == before('earnedDt')
               + getAfter(/databases/$(database)/documents/earnings/$(request.resource.data.lastEarningId)).data.amountDt;
      }
      function payoutAdded() {
        return request.resource.data.earnedDt == before('earnedDt')
          && !exists(/databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId))
          && existsAfter(/databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId))
          && request.resource.data.withdrawnDt == before('withdrawnDt')
               + getAfter(/databases/$(database)/documents/payouts/$(request.resource.data.lastPayoutId)).data.amountDt
          && request.resource.data.withdrawnDt <= request.resource.data.earnedDt;
      }
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() || (isApprovedCollector() && isSelf(uid) && (earningAdded() || payoutAdded()));
    }

    match /payouts/{id} {
      allow read: if signedIn() && (resource.data.collectorUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.amountDt >= 20
        && getAfter(/databases/$(database)/documents/collectorBalances/$(request.auth.uid)).data.lastPayoutId == id;
      allow update: if isAdmin();
    }

    match /deposits/{id} {
      allow read: if signedIn() && (resource.data.collectorUid == request.auth.uid
        || resource.data.recyclerUid == request.auth.uid || isAdmin());
      allow create: if isApprovedCollector()
        && request.resource.data.collectorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.missionIds.size() <= 50
        && get(/databases/$(database)/documents/companies/$(request.resource.data.recyclerUid)).data.status == 'approved';
      // Le recycleur destinataire confirme ou refuse la réception.
      allow update: if isAdmin() || (signedIn() && resource.data.recyclerUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['confirmed', 'rejected']
        && changed().hasOnly(['status', 'note', 'reviewedAt', 'receivedKg', 'quality',
                              'contaminationPct', 'lotIds']));
    }

    // --- Epic 7 : suivi et notifications --------------------------------
    // Boîte d'envoi : uniquement entre les parties d'une même collecte.
    match /notifications/{id} {
      function parties(c) {
        return [c.citizenUid, c.get('collectorUid', ''), c.get('proposedCollectorUid', '')];
      }
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      // Lot en route (US-086) : du collecteur au recycleur du dépôt.
      function depositNotice() {
        let d = get(/databases/$(database)/documents/deposits/$(request.resource.data.collectionId)).data;
        return d.collectorUid == request.auth.uid && d.recyclerUid == request.resource.data.toUid;
      }
      // Marketplace (US-098 à US-100) : entre membres du fil ou parties de la commande.
      function marketNotice() {
        let cid = request.resource.data.collectionId;
        let to = request.resource.data.toUid;
        let deal = /databases/$(database)/documents/deals/$(cid);
        let order = /databases/$(database)/documents/orders/$(cid);
        return (request.resource.data.type in ['marketMessage', 'marketProposal'] && exists(deal)
            && request.auth.uid in get(deal).data.members && to in get(deal).data.members)
          || (request.resource.data.type == 'orderUpdate' && exists(order)
            && request.auth.uid in get(order).data.parties && to in get(order).data.parties);
      }
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.toUid != request.auth.uid
        && ((request.resource.data.type == 'depositIncoming' && depositNotice())
          || (request.resource.data.type in ['marketMessage', 'marketProposal', 'orderUpdate'] && marketNotice())
          || (!(request.resource.data.type in ['depositIncoming', 'marketMessage', 'marketProposal', 'orderUpdate'])
            && request.auth.uid in parties(get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data)
            && request.resource.data.toUid in parties(get(/databases/$(database)/documents/collections/$(request.resource.data.collectionId)).data)));
      allow update: if signedIn() && resource.data.toUid == request.auth.uid && changed().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // Position du collecteur : écrite par lui, lue par le citoyen,
    // seulement pendant le trajet (US-063).
    match /liveLocations/{cid} {
      function mission() { return get(/databases/$(database)/documents/collections/$(cid)).data; }
      function travelling() { return mission().status in ['onTheWay', 'arrived']; }
      allow get: if signedIn() && travelling()
        && (mission().citizenUid == request.auth.uid || mission().get('collectorUid', '') == request.auth.uid);
      allow create, update: if isApprovedCollector() && travelling()
        && mission().collectorUid == request.auth.uid
        && request.resource.data.collectorUid == request.auth.uid;
      allow delete: if signedIn() && mission().get('collectorUid', '') == request.auth.uid;
    }

    // Jetons FCM : écrits par l'appareil, lus seulement par le serveur.
    match /fcmTokens/{token} {
      allow read: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Epic 8 : Recycle Wallet & EcoPoints ------------------------------
    // Sans serveur, le citoyen écrit lui-même ses gains : les règles
    // recalculent chaque gain à partir de la pesée du collecteur et
    // n'autorisent une variation du wallet qu'avec son mouvement.
    function doc(p) { return path('/databases/' + database + '/documents/' + p); }
    function walletDoc(u) { return /databases/$(database)/documents/wallets/$(u); }
    function entryDoc(id) { return /databases/$(database)/documents/pointEntries/$(id); }
    function pointsRules() {
      return exists(/databases/$(database)/documents/config/points)
        ? get(/databases/$(database)/documents/config/points).data
        : {'pointsPerKg': 10, 'firstCollectionBonus': 50, 'bigDropKg': 10, 'bigDropBonus': 20,
           'referralBonus': 100, 'dailyLimit': 3, 'maxKgPerCollection': 200, 'anomalyRatio': 3,
           'multipliers': {'pet_bottle': 1.5, 'can': 2.0, 'cardboard': 1.0, 'paper': 1.0, 'glass': 1.2,
                           'e_waste': 3.0, 'organic': 0.5, 'medical': 0.0, 'other': 1.0}};
    }
    // Même calcul que computeAward (lib/features/wallet/domain/points_rules.dart).
    function expectedPoints(est, r, first) {
      let k = est.actualKg;
      let m = r.multipliers;
      let known = k.get('pet_bottle', 0) + k.get('can', 0) + k.get('cardboard', 0) + k.get('paper', 0)
        + k.get('glass', 0) + k.get('e_waste', 0) + k.get('organic', 0) + k.get('medical', 0);
      let weighted = k.get('pet_bottle', 0) * m.get('pet_bottle', 1) + k.get('can', 0) * m.get('can', 1)
        + k.get('cardboard', 0) * m.get('cardboard', 1) + k.get('paper', 0) * m.get('paper', 1)
        + k.get('glass', 0) * m.get('glass', 1) + k.get('e_waste', 0) * m.get('e_waste', 1)
        + k.get('organic', 0) * m.get('organic', 1) + k.get('medical', 0) * m.get('medical', 1)
        + (est.actualTotalKg - known) * m.get('other', 1);
      return math.floor(weighted * r.pointsPerKg + 0.000001)
        + (first ? r.firstCollectionBonus : 0)
        + (est.actualTotalKg >= r.bigDropKg ? r.bigDropBonus : 0);
    }
    // Anti-fraude (US-075) : poids hors norme, écart à l'estimation, cadence.
    function expectedHeld(est, r, dayCount) {
      return est.actualTotalKg > r.maxKgPerCollection
        || (est.get('totalKg', 0) > 0 && est.actualTotalKg > est.totalKg * r.anomalyRatio)
        || dayCount > r.dailyLimit;
    }

    match /pointEntries/{eid} {
      function e() { return request.resource.data; }
      function walletBefore(u) { return exists(walletDoc(u)) ? get(walletDoc(u)).data : {}; }
      function walletAfter(u) { return getAfter(walletDoc(u)).data; }
      function earnEntry() {
        let c = get(doc('collections/' + e().collectionId)).data;
        let est = get(doc('estimates/' + c.estimateCode)).data;
        let w = walletAfter(request.auth.uid);
        let first = walletBefore(request.auth.uid).get('collections', 0) == 0;
        return eid == 'c_' + e().collectionId
          && c.citizenUid == request.auth.uid
          && c.status == 'completed'
          && est.status == 'weighed'
          && e().kg == est.actualTotalKg
          && e().byCategory == est.actualKg
          && w.lastEntryId == eid
          && math.abs(e().points - expectedPoints(est, pointsRules(), first)) <= 1
          && e().status == (expectedHeld(est, pointsRules(), w.dayCount) ? 'held' : 'credited');
      }
      function redeemEntry() {
        let red = getAfter(doc('redemptions/' + e().redemptionId)).data;
        return eid == 'r_' + e().redemptionId
          && red.uid == request.auth.uid
          && e().points + red.cost == 0
          && e().status == 'credited'
          && walletAfter(request.auth.uid).lastEntryId == eid;
      }
      function expireEntry() {
        return e().points < 0 && e().status == 'credited'
          && walletAfter(request.auth.uid).lastEntryId == eid;
      }
      // Bonus du parrain, écrit par le filleul à sa première collecte (US-077).
      function referralEntry() {
        let me = walletBefore(request.auth.uid);
        return eid == 'ref_' + request.auth.uid
          && e().status == 'credited'
          && me.get('referredBy', null) == e().uid
          && me.get('collections', 0) == 0
          && walletAfter(request.auth.uid).get('collections', 0) == 1
          && e().points == pointsRules().referralBonus
          && walletAfter(e().uid).lastEntryId == eid;
      }
      function ownEntry() {
        return e().type == 'referral' ? referralEntry()
          : e().uid == request.auth.uid && (
              e().type == 'earn' ? earnEntry()
              : e().type == 'redeem' ? redeemEntry()
              : e().type == 'expire' ? expireEntry()
              : false);
      }
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && (ownEntry() || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /wallets/{uid} {
      function a() { return request.resource.data; }
      function b(k, d) { return resource == null ? d : resource.data.get(k, d); }
      function same(k, d) { return a().get(k, d) == b(k, d); }
      function en() { return getAfter(entryDoc(a().lastEntryId)).data; }
      function newEntry() {
        return a().get('lastEntryId', null) is string
          && !exists(entryDoc(a().lastEntryId)) && existsAfter(entryDoc(a().lastEntryId));
      }
      function balanceOk() {
        return a().get('earned', 0) - a().get('spent', 0) - a().get('expired', 0) >= 0;
      }
      // Champs pilotés par l'administration ou posés une seule fois.
      function fixed() {
        return same('frozen', false) && same('frozenReason', null)
          && same('referredBy', null) && same('referralCode', null);
      }
      function earnSide() {
        return same('held', 0) && same('collections', 0) && same('kg', 0)
          && same('dayCount', 0) && same('lastEarnAt', null);
      }
      function earnUpdate() {
        let p = en().points;
        let held = en().status == 'held';
        // Premier gain : pas de date, compteur à 0 → 1 dans les deux branches.
        let sameDay = b('lastEarnAt', request.time).date() == request.time.date();
        return isSelf(uid) && en().uid == uid
          && a().earned == b('earned', 0) + (held ? 0 : p)
          && a().held == b('held', 0) + (held ? p : 0)
          && a().collections == b('collections', 0) + 1
          && a().kg == b('kg', 0) + en().kg
          && a().dayCount == (sameDay ? b('dayCount', 0) + 1 : 1)
          && a().lastEarnAt == request.time
          && same('spent', 0) && same('expired', 0) && same('lastRedemptionId', null) && fixed();
      }
      function redeemUpdate() {
        return isSelf(uid) && en().uid == uid && !b('frozen', false)
          && a().spent == b('spent', 0) - en().points
          && a().lastRedemptionId == en().redemptionId
          && balanceOk() && same('earned', 0) && same('expired', 0) && earnSide() && fixed();
      }
      function expireUpdate() {
        return isSelf(uid) && en().uid == uid
          && a().expired == b('expired', 0) - en().points
          && balanceOk() && same('earned', 0) && same('spent', 0)
          && same('lastRedemptionId', null) && earnSide() && fixed();
      }
      function referralCredit() {
        return signedIn() && request.auth.uid != uid
          && a().lastEntryId == 'ref_' + request.auth.uid && en().uid == uid
          && a().earned == b('earned', 0) + en().points
          && same('spent', 0) && same('expired', 0) && same('lastRedemptionId', null)
          && earnSide() && fixed();
      }
      function counters() {
        return same('earned', 0) && same('spent', 0) && same('expired', 0)
          && same('lastRedemptionId', null) && earnSide();
      }
      function setReferralCode() {
        return isSelf(uid) && b('referralCode', null) == null && a().referralCode is string
          && getAfter(doc('referralCodes/' + a().referralCode)).data.uid == uid
          && counters() && same('referredBy', null) && same('frozen', false) && same('frozenReason', null);
      }
      function setReferrer() {
        return isSelf(uid) && b('referredBy', null) == null && a().referredBy is string
          && a().referredBy != uid && b('collections', 0) == 0
          && get(walletDoc(a().referredBy)).data.get('referralCode', null) != null
          && counters() && same('referralCode', null) && same('frozen', false) && same('frozenReason', null);
      }
      function walletChange() {
        return a().keys().hasOnly(['earned', 'spent', 'expired', 'held', 'collections', 'kg', 'dayCount',
            'lastEarnAt', 'lastEntryId', 'lastRedemptionId', 'referredBy', 'referralCode', 'frozen', 'frozenReason'])
          && (same('lastEntryId', null)
            ? (setReferralCode() || setReferrer())
            : newEntry() && (en().type == 'earn' ? earnUpdate()
                : en().type == 'redeem' ? redeemUpdate()
                : en().type == 'expire' ? expireUpdate()
                : en().type == 'referral' ? referralCredit()
                : false));
      }
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if signedIn() && (walletChange() || isAdmin());
      allow delete: if isAdmin();
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 6
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(walletDoc(request.auth.uid)).data.referralCode == code;
      allow update, delete: if isAdmin();
    }

    // Catalogue de récompenses (US-072, US-074).
    match /partners/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /rewards/{id} {
      // Stock décrémenté par l'échange (même batch que le coupon).
      function stockTaken() {
        let rid = getAfter(walletDoc(request.auth.uid)).data.lastRedemptionId;
        return changed().hasOnly(['stock'])
          && resource.data.get('stock', null) is int && resource.data.stock > 0
          && request.resource.data.stock == resource.data.stock - 1
          && !exists(doc('redemptions/' + rid))
          && getAfter(doc('redemptions/' + rid)).data.rewardId == id;
      }
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn() && (stockTaken() || isAdmin());
    }

    // Coupons (US-073) : validés chez le partenaire par l'administration.
    match /redemptions/{rid} {
      function redemptionOk() {
        let d = request.resource.data;
        let rw = get(doc('rewards/' + d.rewardId)).data;
        return d.uid == request.auth.uid && d.status == 'active'
          && d.cost == rw.cost && rw.active == true
          && d.code is string && d.code.size() == 9
          && getAfter(walletDoc(request.auth.uid)).data.lastRedemptionId == rid
          && existsAfter(entryDoc('r_' + rid))
          && (rw.get('stock', null) == null || getAfter(doc('rewards/' + d.rewardId)).data.stock == rw.stock - 1);
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && redemptionOk();
      allow update, delete: if isAdmin();
    }

    // --- Epic 9 : espace recycleur ------------------------------------------
    function isApprovedRecycler() {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.status == 'approved';
    }
    function lotAfter(id) { return getAfter(/databases/$(database)/documents/lots/$(id)).data; }

    // Lots en stock (US-081) : une réception n'existe que liée à un dépôt
    // confirmé par ce recycleur (US-080) ; le poids restant ne fait que
    // baisser (sorties, production).
    match /lots/{id} {
      function n() { return request.resource.data; }
      function fromDeposit() {
        let dep = getAfter(/databases/$(database)/documents/deposits/$(n().depositId)).data;
        return dep.recyclerUid == request.auth.uid && dep.status == 'confirmed' && id in dep.lotIds;
      }
      allow read: if signedIn() && (resource.data.recyclerUid == request.auth.uid || isAdmin());
      allow create: if isApprovedRecycler()
        && n().recyclerUid == request.auth.uid
        && n().material in ['pet', 'hdpe', 'pp', 'cardboard', 'aluminium', 'glass', 'other']
        && n().grade in ['a', 'b', 'c']
        && n().form in ['raw', 'bales', 'flakes', 'granules']
        && n().initialKg is number && n().initialKg > 0 && n().kg == n().initialKg
        && (n().source == 'production' ? n().form != 'raw' : n().source == 'reception' && fromDeposit());
      allow update: if signedIn() && resource.data.recyclerUid == request.auth.uid
        && changed().hasOnly(['kg', 'marketplace'])
        && request.resource.data.kg is number
        && request.resource.data.kg >= 0 && request.resource.data.kg <= resource.data.initialKg;
      allow delete: if isAdmin();
    }

    // Mouvements et productions : historique immuable du recycleur.
    match /stockMoves/{id} {
      allow read: if signedIn() && (resource.data.recyclerUid == request.auth.uid || isAdmin());
      allow create: if isApprovedRecycler()
        && request.resource.data.recyclerUid == request.auth.uid
        && request.resource.data.reason in ['reception', 'production', 'sale', 'loss', 'adjust']
        && request.resource.data.deltaKg is number
        && lotAfter(request.resource.data.lotId).recyclerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /productions/{id} {
      allow read: if signedIn() && (resource.data.recyclerUid == request.auth.uid || isAdmin());
      allow create: if isApprovedRecycler()
        && request.resource.data.recyclerUid == request.auth.uid
        && request.resource.data.outputKg <= request.resource.data.inputKg
        && lotAfter(request.resource.data.outputLotId).recyclerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Epic 10 : prévision des volumes -------------------------------------
    // Prévisions calculées et publiées par l'administration (pas de serveur) ;
    // lues par les recycleurs validés (US-088, US-089).
    match /forecasts/{zoneId} {
      allow read: if isAdmin() || isApprovedRecycler();
      allow write: if isAdmin();
    }
    // Historique des entraînements, précision et alertes (US-091 à US-093).
    match /forecastRuns/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // --- Epic 11 : marketplace B2B -------------------------------------------
    match /listings/{id} {
      function n() { return request.resource.data; }
      function valid() {
        return n().type in ['buy', 'sell']
          && n().material in ['pet', 'hdpe', 'pp', 'cardboard', 'aluminium', 'glass', 'other']
          && n().form in ['raw', 'bales', 'flakes', 'granules']
          && n().quantityKg is number && n().quantityKg > 0
          && (n().priceDtPerKg == null || (n().priceDtPerKg is number && n().priceDtPerKg > 0))
          && (n().type == 'buy' || n().priceDtPerKg != null)
          && n().deadline is timestamp
          && n().city is string && n().city.size() > 0 && n().city.size() <= 80
          && n().description is string && n().description.size() <= 1000
          && n().lotIds is list && n().lotIds.size() <= 20;
      }
      allow read: if isAdmin()
        || (isApprovedRecycler() && (resource.data.status == 'open' || resource.data.ownerUid == request.auth.uid));
      allow create: if isApprovedRecycler() && n().ownerUid == request.auth.uid && n().status == 'open' && valid();
      // Auteur : modification, clôture, réouverture (jamais d'une annonce
      // suspendue ou retirée). Administration : modération (US-103).
      allow update: if isAdmin()
        || (isApprovedRecycler() && resource.data.ownerUid == request.auth.uid
            && n().ownerUid == resource.data.ownerUid && n().type == resource.data.type
            && resource.data.status in ['open', 'closed'] && n().status in ['open', 'closed'] && valid())
        // Clôture par l'acceptation d'une proposition, côté contrepartie.
        || (isApprovedRecycler() && changed().hasOnly(['status']) && n().status == 'closed'
            && exists(/databases/$(database)/documents/deals/$(id + '_' + request.auth.uid)));
      allow delete: if false;
    }

    match /listingReports/{id} {
      allow create: if isApprovedRecycler()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.resolved == false
        && request.resource.data.text.size() <= 500;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Fil de négociation entre l'auteur d'une annonce et une entreprise.
    match /deals/{dealId} {
      function d() { return request.resource.data; }
      function listingOf(lid) { return get(/databases/$(database)/documents/listings/$(lid)).data; }
      allow read: if signedIn() && (request.auth.uid in resource.data.members || isAdmin());
      allow create: if isApprovedRecycler()
        && d().counterpartUid == request.auth.uid
        && dealId == d().listingId + '_' + request.auth.uid
        && d().ownerUid == listingOf(d().listingId).ownerUid
        && d().ownerUid != request.auth.uid
        && listingOf(d().listingId).status == 'open'
        && d().members == [d().ownerUid, request.auth.uid];
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && !changed().hasAny(['listingId', 'ownerUid', 'counterpartUid', 'members']);
      allow delete: if false;

      match /messages/{m} {
        function members() { return get(/databases/$(database)/documents/deals/$(dealId)).data.members; }
        function msg() { return request.resource.data; }
        allow read: if signedIn() && (request.auth.uid in members() || isAdmin());
        allow create: if signedIn() && request.auth.uid in members()
          && msg().fromUid == request.auth.uid
          && msg().text is string && msg().text.size() <= 1000
          && ((msg().kind == 'text' && msg().text.size() > 0)
            || (msg().kind == 'proposal' && msg().priceDtPerKg is number && msg().priceDtPerKg > 0
              && msg().quantityKg is number && msg().quantityKg > 0
              && msg().deliveryDays is int && msg().deliveryDays >= 0 && msg().status == 'pending'));
        // Le destinataire accepte (commande du même batch) ou refuse ; l'auteur retire.
        allow update: if signedIn() && request.auth.uid in members()
          && resource.data.kind == 'proposal' && resource.data.status == 'pending'
          && changed().hasOnly(['status'])
          && ((resource.data.fromUid != request.auth.uid && msg().status == 'declined')
            || (resource.data.fromUid != request.auth.uid && msg().status == 'accepted'
              && existsAfter(/databases/$(database)/documents/orders/$(m)))
            || (resource.data.fromUid == request.auth.uid && msg().status == 'withdrawn'));
        allow delete: if false;
      }
    }

    // Commande (US-099, US-100) : née d'une proposition acceptée, aux
    // conditions exactes de la proposition.
    match /orders/{oid} {
      function o() { return request.resource.data; }
      function fromProposal() {
        let path = /databases/$(database)/documents/deals/$(o().dealId)/messages/$(oid);
        let p = getAfter(path).data;
        let deal = get(/databases/$(database)/documents/deals/$(o().dealId)).data;
        let l = get(/databases/$(database)/documents/listings/$(o().listingId)).data;
        return request.auth.uid in deal.members && p.fromUid != request.auth.uid
          && get(path).data.status == 'pending' && p.status == 'accepted'
          && deal.listingId == o().listingId
          && o().quantityKg == p.quantityKg && o().priceDtPerKg == p.priceDtPerKg
          && o().deliveryDays == p.deliveryDays
          && o().material == l.material && o().parties == deal.members
          && ((l.type == 'sell' && o().sellerUid == deal.ownerUid && o().buyerUid == deal.counterpartUid
               && o().lotIds == l.lotIds)
            || (l.type == 'buy' && o().buyerUid == deal.ownerUid && o().sellerUid == deal.counterpartUid
               && o().lotIds.size() == 0))
          && o().status == 'confirmed' && o().payment == 'pending'
          && o().get('sellerRating', null) == null && o().get('buyerRating', null) == null;
      }
      function r() { return resource.data; }
      function seller() { return request.auth.uid == r().sellerUid; }
      function buyer() { return request.auth.uid == r().buyerUid; }
      function step(a, b) { return r().status == a && o().status == b; }
      function sellerStep() {
        return seller() && changed().hasOnly(['status', 'history', 'origin'])
          && (step('confirmed', 'preparing') || step('preparing', 'shipped') || step('shipped', 'delivered'));
      }
      function buyerStep() {
        return buyer() && changed().hasOnly(['status', 'history']) && step('delivered', 'completed');
      }
      function cancelStep() {
        return changed().hasOnly(['status', 'history'])
          && r().status in ['confirmed', 'preparing'] && o().status == 'cancelled';
      }
      function paymentStep() {
        return changed().hasOnly(['payment'])
          && ((buyer() && r().payment == 'pending' && o().payment == 'declared')
            || (seller() && r().payment in ['pending', 'declared'] && o().payment == 'received'));
      }
      // Note (US-101) : une fois, après la commande terminée.
      function rateStep() {
        return r().status == 'completed'
          && ((buyer() && changed().hasOnly(['sellerRating']) && r().get('sellerRating', null) == null
               && o().sellerRating in [1, 2, 3, 4, 5])
            || (seller() && changed().hasOnly(['buyerRating']) && r().get('buyerRating', null) == null
               && o().buyerRating in [1, 2, 3, 4, 5]));
      }
      allow read: if signedIn() && (request.auth.uid in resource.data.parties || isAdmin());
      allow create: if isApprovedRecycler() && fromProposal();
      allow update: if signedIn() && request.auth.uid in resource.data.parties
        && (sellerStep() || buyerStep() || cancelStep() || paymentStep() || rateStep());
      allow delete: if false;
    }

    match /companyStats/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid != uid
        && request.resource.data.ratingCount == (resource == null ? 0 : resource.data.ratingCount) + 1;
    }
  }
}
